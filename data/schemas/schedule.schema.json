{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Optimized Schedule",
  "type": "object",
  "properties": {
    "schedule_id": { "type": "string" },
    "blocks_scheduled": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": { "type": "string" },
          "start_time_min": { "type": "integer" },
          "end_time_min": { "type": "integer" }
        },
        "required": ["request_id", "start_time_min", "end_time_min"]
      }
    },
    "blocks_unscheduled": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["schedule_id", "blocks_scheduled", "blocks_unscheduled"]
}
